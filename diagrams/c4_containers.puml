@startuml c4_containers
' C4 Level 2 - Containers: Citizen Services Portal
' Question answered: which deployable parts make up the portal, what does each own, and how do they talk?
' Business data (cases, documents, profile, delegations) stays with agencies and registries and is
' read live through the Agency integration service; the portal keeps only a minimal database.
' Render: plantuml -tsvg diagrams/c4_containers.puml

!include <C4/C4_Container>

HIDE_STEREOTYPE()
LAYOUT_LEFT_RIGHT()
skinparam nodesep 30
skinparam ranksep 60

title Container diagram - Citizen Services Portal

Person(resident, "Resident / Citizen", "Incl. delegates")
Person(staff, "Admin / Helpdesk / Auditor", "Role-limited access")
System_Ext(thirdParty, "Third-party providers", "Public API clients")
Person(ops, "Operations / Security")

System_Boundary(portal, "Citizen Services Portal") {
  Boundary(edge, "Front end and entry") {
    Container(web, "Citizen web app", "Web SPA", "Localized citizen UI")
    Container(backoffice, "Back-office web app", "Web SPA", "Helpdesk, admin, audit review")
    Container(gateway, "API gateway", "Gateway", "Token validation, scopes, rate limits, API versioning")
  }
  Boundary(svc, "Business services") {
    Container(iam, "Identity & access", "Service", "eID login, sessions, role and delegation checks")
    Container(catalogue, "Catalogue & profile", "Service", "Service catalogue, preferences")
    Container(cases, "Case service", "Service", "Submits requests, live case status")
    Container(docs, "Document service", "Service", "Upload, scan, deliver, download")
    Container(signing, "Signing service", "Service", "eID signing flow")
  }
  Boundary(shared, "Shared services") {
    ContainerQueue(bus, "Message broker", "Async messaging", "Delivery queue, notification and audit events")
    Container(integration, "Agency integration", "Adapters", "Per-agency adapters, data minimization, retries")
    Container(notify, "Notification service", "Service", "Inbox, email/SMS/push dispatch")
    Container(audit, "Audit service", "Service", "Audit trail, transparency queries")
    Container(scanner, "Antivirus scanner", "Scan engine")
  }
  ContainerDb(portalDb, "Portal DB (minimal)", "Relational DB", "Preferences, catalogue config, API clients")
  ContainerDb(docStore, "Temporary doc store", "Object storage", "Quarantine and transit only")
  ContainerDb(auditStore, "Audit store", "Append-only", "Tamper-evident records")
  Container(observability, "Observability", "Monitoring, logs, tracing", "Health, alerts, security events")
}

System_Ext(idp, "National eID / OIDC provider")
System_Ext(signExt, "Digital signing service")
System_Ext(agencies, "Agency back-end e-services")
System_Ext(registries, "External registries", "Population, business, mandates")
System_Ext(notifyExt, "Notification providers", "Email, SMS, push")

Rel(resident, web, "Uses", "HTTPS")
Rel(staff, backoffice, "Uses", "HTTPS")
Rel(thirdParty, gateway, "Calls public APIs", "OAuth 2.0")
Rel(ops, observability, "Monitors")
Rel(web, gateway, "API calls")
Rel(backoffice, gateway, "API calls")

Rel(gateway, iam, "AuthN / AuthZ")
Rel(gateway, catalogue, "Routes")
Rel(gateway, cases, "Routes")
Rel(gateway, docs, "Routes")
Rel(gateway, signing, "Routes")
Rel(gateway, audit, "Transparency queries")

Rel(iam, idp, "Authenticates", "OIDC")
Rel(signing, signExt, "Signs, validates")
Rel(signing, docs, "Gets document")
Rel(docs, scanner, "Scans uploads")
Rel(iam, integration, "Verifies delegations")
Rel(catalogue, integration, "Reads profile")
Rel(cases, integration, "Reads case status")
Rel(docs, integration, "Delivers / fetches docs")
Rel(cases, bus, "Publishes requests")
Rel(bus, integration, "Queued delivery")
Rel(bus, notify, "Case events")
Rel(bus, audit, "Audit events (all services)")

Rel(integration, agencies, "Requests, status, docs", "mTLS")
Rel(integration, registries, "Minimal lookups", "mTLS")
Rel(notify, notifyExt, "Sends")

Rel(catalogue, portalDb, "R/W")
Rel(iam, portalDb, "R/W")
Rel(docs, docStore, "Temp.")
Rel(audit, auditStore, "Append")

SHOW_LEGEND()
@enduml
