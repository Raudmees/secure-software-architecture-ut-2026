@startuml c4_system_context
' C4 Level 1 - System Context: Citizen Services Portal
' Question answered: who uses the portal, and which external systems does it depend on or serve?
' Render: plantuml -tsvg diagrams/c4_system_context.puml

!include <C4/C4_Context>

LAYOUT_TOP_DOWN()

title System Context - Citizen Services Portal

Person(resident, "Resident / Citizen", "Finds, requests and tracks public services; exchanges documents and messages; signs documents; sees who accessed their data. May act as a delegate for another person within a given scope.")
Person(admin, "Administrator / Helpdesk", "Supports residents and operates the portal with role-limited access to case data.")
Person(auditor, "Auditor / Oversight body", "Verifies that citizen data was accessed and processed lawfully.")
Person(ops, "Operations / Security team", "Monitors service health and responds to incidents and security events.")
Person_Ext(agencyStaff, "Agency staff", "Processes requests for their own organization's services.")

System(portal, "Citizen Services Portal", "Single digital entry point for public services: service catalogue, case management, document exchange, signing workflow, notifications, delegation, audit and transparency, regulated public APIs.")

System_Ext(idp, "National eID / OIDC identity provider", "Authenticates residents. The portal trusts only configured providers and validates every token.")
System_Ext(signing, "Digital signing service", "Creates and validates legally binding eID signatures.")
System_Ext(agencies, "Agency back-end e-services", "Systems of the agencies that deliver and decide the services. Separate trust domain.")
System_Ext(registries, "External registries", "Authoritative data such as population, business and mandate/delegation registries.")
System_Ext(thirdParty, "Third-party service providers", "Consume the portal's regulated public APIs as registered clients.")
System_Ext(notify, "Notification providers", "Deliver email, SMS and push messages.")

' Each relationship has its own colour; the label text matches its line.
AddRelTag("r1", $textColor="#1f77b4", $lineColor="#1f77b4")
AddRelTag("r2", $textColor="#2ca02c", $lineColor="#2ca02c")
AddRelTag("r3", $textColor="#9467bd", $lineColor="#9467bd")
AddRelTag("r4", $textColor="#8c564b", $lineColor="#8c564b")
AddRelTag("r5", $textColor="#d62728", $lineColor="#d62728")
AddRelTag("r6", $textColor="#e377c2", $lineColor="#e377c2")
AddRelTag("r7", $textColor="#ff7f0e", $lineColor="#ff7f0e")
AddRelTag("r8", $textColor="#17becf", $lineColor="#17becf")
AddRelTag("r9", $textColor="#7f7f7f", $lineColor="#7f7f7f")
AddRelTag("r10", $textColor="#bcbd22", $lineColor="#bcbd22")
AddRelTag("r11", $textColor="#393b79", $lineColor="#393b79")
AddRelTag("r12", $textColor="#637939", $lineColor="#637939")

Rel(resident, portal, "Finds services, submits and tracks requests, uploads documents, signs, reviews data-access log", $tags="r1")
Rel(admin, portal, "Supports residents and administers the portal via back-office functions", $tags="r2")
Rel(auditor, portal, "Reviews audit evidence (read-only)", $tags="r3")
Rel(ops, portal, "Monitors health, logs and security events", $tags="r4")

Rel(portal, idp, "Delegates resident authentication to", $tags="r5")
Rel(portal, signing, "Sends documents or hashes to sign; validates signatures", $tags="r6")
Rel(portal, agencies, "Forwards requests and documents; receives case status and decisions", $tags="r7")
Rel(portal, registries, "Looks up minimal required data; verifies delegations", $tags="r8")
Rel(thirdParty, portal, "Calls regulated public APIs (registered clients, rate-limited)", $tags="r9")
Rel(portal, notify, "Sends notifications", $tags="r10")
Rel(notify, resident, "Delivers email, SMS, push", $tags="r11")
Rel(agencyStaff, agencies, "Processes cases in", $tags="r12")

' Keep the per-relationship colour tags out of the legend.
!$tagCustomLegend = ""
SHOW_LEGEND()
@enduml
